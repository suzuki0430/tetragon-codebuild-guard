{
  "name": "tetragon-codebuild-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Detect and block compromised GitHub Actions jobs on AWS CodeBuild with Tetragon.",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "synth": "cdk synth --quiet",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm synth"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "aws-cdk": "2.1137.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
